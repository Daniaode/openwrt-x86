#!/bin/sh /etc/rc.common
# Transparent bridge.
#
# Turns this router into a layer-2 bridge between its physical ports, so
# clients behind it keep the upstream router's subnet, gateway and NAT. The
# device keeps a single management IP on the bridge itself.
#
# Rewriting /etc/config/network makes every interface the vendor image defined
# disappear, so /etc/config/dhcp has to be adjusted in the same pass: dnsmasq
# binds per interface and takes its upstream from the interface that used to
# be 'wan'. Shipping the old dhcp config left the bridge up but DNS dead, which
# looks exactly like "the switch did nothing useful".

START=99

BACKUP=/etc/bridge

ETH() {
	local n="$1" i=0
	while [ "$i" -lt "$n" ]; do
		echo "eth$i"
		i=$((i + 1))
	done
}

phys_ports() {
	local network="$1"
	if [ -z "$network" ] || [ "$network" = "0" ]; then
		ls /sys/class/net | grep -E '^eth' | sort | tr '\n' ' ' | sed 's/ *$//'
	else
		ETH "$network" | tr '\n' ' ' | sed 's/ *$//'
	fi
}

reload_services() {
	/etc/init.d/network reload
	/etc/init.d/dnsmasq restart
	/etc/init.d/firewall reload
}

restore_bridge() {
	[ -d "$BACKUP" ] || return 0

	[ -f "$BACKUP/network" ]  && cp "$BACKUP/network"  /etc/config/network
	[ -f "$BACKUP/firewall" ] && cp "$BACKUP/firewall" /etc/config/firewall
	[ -f "$BACKUP/dhcp" ]     && cp "$BACKUP/dhcp"     /etc/config/dhcp
	rm -rf "$BACKUP"

	logger -t bridge "restored original network configuration"
	reload_services
}

apply_bridge() {
	local gateway="$1" ipaddr="$2" netmask="$3" network="$4"
	local ula eth

	ula=$(uci -q get network.globals.ula_prefix)

	eth=$(phys_ports "$network")
	[ -n "$eth" ] || { logger -t bridge "no physical ports found"; return 1; }

	mkdir -p "$BACKUP"
	# Copy the originals exactly once. A second enable must not overwrite them
	# with the already-bridged configuration, otherwise disable could never
	# restore what the device originally had.
	if [ ! -f "$BACKUP/firewall" ]; then
		cp /etc/config/network  "$BACKUP/network"
		cp /etc/config/firewall "$BACKUP/firewall"
		cp /etc/config/dhcp     "$BACKUP/dhcp"
	fi

	uci -q batch <<EOF
delete network.lan
delete network.wan
delete network.wan6
set network.loopback=interface
set network.loopback.device='lo'
set network.loopback.proto='static'
set network.loopback.ipaddr='127.0.0.1'
set network.loopback.netmask='255.0.0.0'
set network.globals=globals
set network.globals.ula_prefix='$ula'
set network.bridge=interface
set network.bridge.type='bridge'
set network.bridge.ifname='$eth'
set network.bridge.proto='static'
set network.bridge.ipaddr='$ipaddr'
set network.bridge.netmask='$netmask'
set network.bridge.gateway='$gateway'
set network.bridge.dns='$gateway'
set network.bridge.force_link='0'
commit network
EOF

	# dnsmasq: drop the DHCP sections that pointed at the interfaces we just
	# deleted, add one for the bridge so it actually binds there, and pin an
	# upstream server. Without the explicit upstream the device cannot resolve
	# anything at all once 'wan' is gone -- resolv.conf.auto is fed by the
	# interface, and that interface no longer exists.
	#
	# ignore='1' because clients must keep getting DHCP from the upstream
	# router; this device only serves DNS for itself.
	uci -q batch <<EOF
delete dhcp.lan
delete dhcp.wan
delete dhcp.wan6
set dhcp.bridge=dhcp
set dhcp.bridge.interface='bridge'
set dhcp.bridge.ignore='1'
set dhcp.@dnsmasq[0].server='$gateway'
commit dhcp
EOF

	# Keep the operator's firewall. Bridged traffic is switched at layer 2 by
	# the kernel bridge and never traverses these zones, so blanking the file
	# destroyed port forwards and rules for no benefit. Only add the zone the
	# bridge needs if it is missing.
	if [ "$(uci -q show firewall | grep -c "\.name='bridge'")" = "0" ]; then
		uci -q batch <<EOF
add firewall zone
set firewall.@zone[-1].name='bridge'
set firewall.@zone[-1].network='bridge'
set firewall.@zone[-1].input='ACCEPT'
set firewall.@zone[-1].output='ACCEPT'
set firewall.@zone[-1].forward='ACCEPT'
commit firewall
EOF
	fi

	# Remember what was applied so a reload with unchanged settings is a no-op.
	# The original script used `break` here, which is not valid outside a loop
	# and silently did nothing -- so every reload rewrote the configuration and
	# bounced the whole network.
	printf '%s|%s|%s|%s\n' "$ipaddr" "$netmask" "$gateway" "$eth" > "$BACKUP/param"

	logger -t bridge "transparent bridge enabled on: $eth"
	reload_services
}

run_bridge() {
	local cfg="$1" enabled gateway ipaddr netmask network

	config_get_bool enabled "$cfg" enabled 0
	config_get gateway "$cfg" gateway
	config_get ipaddr  "$cfg" ipaddr
	config_get netmask "$cfg" netmask
	config_get network "$cfg" network

	if [ "$enabled" != "1" ]; then
		restore_bridge
		return 0
	fi

	if [ -d /sys/class/net/br-bridge ] &&
	   [ "$(cat "$BACKUP/param" 2>/dev/null)" = "$ipaddr|$netmask|$gateway|$(phys_ports "$network")" ]; then
		return 0
	fi

	apply_bridge "$gateway" "$ipaddr" "$netmask" "$network"
}

start() {
	config_load bridge
	config_foreach run_bridge bridge
}

stop() {
	restore_bridge
}

reload() {
	start
}
